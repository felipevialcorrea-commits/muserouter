# ===== MuseRouter =====
# Port MỚI: 21128 — cố ý khác 9Router (20128, dev 20127) và muse2api (18610, CDP 19210)
# để cả 3 chạy song song trên cùng một máy không đụng nhau.
PORT=21128
HOST=0.0.0.0

# Key để client gọi vào router (Authorization: Bearer ...).
# Để trống = tự sinh mr_... ở lần chạy đầu, lưu trong data/config.json
ROUTER_API_KEY=

# RTK Token Saver: 1 = bật (mặc định), 0 = tắt
RTK_ENABLED=1

# ===== Muse tích hợp sẵn (nhúng engine muse2api vào trong project) =====
# Mặc định BẬT: MuseRouter tự chạy engine Muse, anh chỉ cần vào dashboard
# bấm "Đăng nhập Muse". Cần chạy 1 lần: npm run setup:muse (cài Python deps).
# Đặt MUSE_ENGINE=off nếu muốn tắt engine tích hợp.
MUSE_ENGINE=on
MUSE_ENGINE_PORT=18611
MUSE_ENGINE_CDP_PORT=19211

# (Tùy chọn) Thêm 1 muse2api standalone bên ngoài (port 18610) làm connection dự phòng:
MUSE_BASE_URL=http://localhost:18610
MUSE_API_KEY=

# ===== Các provider khác: điền key nào thì tự seed connection cho provider đó =====
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GLM_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
